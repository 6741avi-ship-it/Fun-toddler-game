* {
  box-sizing: border-box;
  user-select: none;
  -webkit-user-select: none;
  touch-action: manipulation;
}

/* Background Theme Presets via CSS Custom Properties */
:root {
  --theme-bg: linear-gradient(135deg, #a8edf8 0%, #fed6e3 100%);
  --theme-primary: #35a7ff;
}

body.theme-sunshine {
  --theme-bg: linear-gradient(135deg, #ffe259 0%, #ffa751 100%);
  --theme-primary: #e67e22;
}

body.theme-ocean {
  --theme-bg: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  --theme-primary: #0077b6;
}

body.theme-jungle {
  --theme-bg: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
  --theme-primary: #1b4332;
}

body.theme-candy {
  --theme-bg: linear-gradient(135deg, #ff9a9e 0%, #fecfef 99%, #fecfef 100%);
  --theme-primary: #d63384;
}

body {
  margin: 0;
  padding: 0;
  font-family: 'Fredoka', 'Comic Sans MS', cursive, sans-serif;
  background: var(--theme-bg);
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  transition: background 0.4s ease;
}

.app-container {
  width: 95%;
  max-width: 520px;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 28px;
  padding: 18px;
  text-align: center;
  box-shadow: 0 12px 35px rgba(0,0,0,0.15);
  position: relative;
  min-height: 540px;
  display: flex;
  flex-direction: column;
}

/* Header Controls */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.top-controls {
  display: flex;
  gap: 6px;
}

.icon-btn {
  background: #ffffff;
  border: 2px solid var(--theme-primary);
  border-radius: 20px;
  padding: 5px 10px;
  font-weight: bold;
  color: var(--theme-primary);
  cursor: pointer;
  font-size: 0.8rem;
  transition: border-color 0.3s, color 0.3s;
}

.score-board {
  font-size: 1.2rem;
  font-weight: bold;
  color: #ff9f1c;
}

/* Layout Views */
.view {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.hidden { display: none !important; }

h1 { color: #ff5964; font-size: 1.9rem; margin: 0 0 5px; }
h2 { color: #2a9d8f; font-size: 1.7rem; margin: 0 0 8px; }
.subtitle { font-size: 1rem; color: #555; font-weight: bold; margin-bottom: 12px; }

/* Dashboard Cards */
.menu-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 8px;
}

.menu-card {
  background: #f8f9fa;
  border: 3px solid #e9ecef;
  border-radius: 20px;
  padding: 16px 8px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 5px 0 #dee2e6;
  transition: transform 0.1s;
}

.menu-card:active { transform: translateY(3px); box-shadow: 0 2px 0 #dee2e6; }
.card-icon { font-size: 2.8rem; }
.card-title { font-size: 1rem; font-weight: bold; color: #333; margin-top: 6px; }

/* Game 1: Shape Match */
.difficulty-picker { display: flex; justify-content: center; gap: 8px; margin-bottom: 8px; }
.diff-btn {
  background: #e0e0e0;
  border: none;
  border-radius: 12px;
  padding: 5px 10px;
  font-size: 0.8rem;
  font-weight: bold;
  cursor: pointer;
  color: #555;
}
.diff-btn.active { background: #ffbc42; color: #fff; }

.target-zone { display: flex; justify-content: center; margin: 8px 0; }
.shape-slot {
  width: 110px;
  height: 110px;
  border: 5px dashed #aaa;
  border-radius: 20px;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #f8f8f8;
}

.choices-zone { display: flex; justify-content: center; align-items: center; min-height: 85px; gap: 10px; }
.shape { width: 65px; height: 65px; cursor: grab; display: flex; justify-content: center; align-items: center; touch-action: none; }
.shape.dragging { opacity: 0.85; cursor: grabbing; z-index: 1000; }

.shape.circle { border-radius: 50%; }
.shape.square { border-radius: 12px; }
.shape.star { clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }
.shape.triangle { width: 0; height: 0; border-left: 32px solid transparent; border-right: 32px solid transparent; border-bottom: 60px solid; background: transparent !important; }
.shape.heart { clip-path: polygon(50% 18%, 65% 0%, 85% 0%, 100% 20%, 100% 45%, 50% 95%, 0% 45%, 0% 20%, 15% 0%, 35% 0%); }
.shape.moon { clip-path: polygon(40% 0%, 100% 10%, 70% 50%, 100% 90%, 40% 100%, 0% 50%); border-radius: 50%; }

.message { font-size: 1rem; font-weight: bold; color: #333; min-height: 22px; }

/* Game 2: Safari Grid */
.animal-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
}
.animal-btn {
  background: #f4f1de;
  border: 3px solid #3d405b;
  border-radius: 16px;
  padding: 10px 4px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.emoji { font-size: 2.2rem; }
.label { font-size: 0.85rem; font-weight: bold; color: #3d405b; margin-top: 2px; }

/* Game 3: Pop Balloon */
.sky {
  width: 100%;
  height: 270px;
  background: linear-gradient(180deg, #87ceeb 0%, #e0f6ff 100%);
  border-radius: 20px;
  position: relative;
  overflow: hidden;
  margin-top: 5px;
}
.balloon {
  width: 55px;
  height: 70px;
  border-radius: 50% 50% 50% 50% / 40% 40% 60% 60%;
  position: absolute;
  bottom: -80px;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 1.4rem;
  font-weight: bold;
  color: #fff;
  cursor: pointer;
  box-shadow: inset -5px -5px 0 rgba(0,0,0,0.15);
  touch-action: none;
}

/* Game 4: Hungry Monster */
.monster-space { height: 100px; display: flex; justify-content: center; align-items: center; }
.monster { font-size: 4.5rem; transition: transform 0.2s ease; }
.speech-bubble { background: #480ca8; color: #fff; padding: 8px 14px; border-radius: 16px; font-size: 1rem; font-weight: bold; margin: 8px 0; }
.food-tray { display: flex; justify-content: space-around; margin-top: 8px; }
.food-item { font-size: 2.5rem; background: #f0f0f0; padding: 8px; border-radius: 16px; cursor: pointer; border: 3px solid #ccc; }

.action-btn {
  background: #ffbc42;
  border: none;
  padding: 8px 20px;
  font-size: 1.1rem;
  font-weight: bold;
  color: #fff;
  border-radius: 50px;
  cursor: pointer;
  box-shadow: 0 4px 0 #d99b26;
  margin-top: 8px;
}

@keyframes bounce { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.15) rotate(5deg); } }
.celebrate { animation: bounce 0.5s ease infinite; }
