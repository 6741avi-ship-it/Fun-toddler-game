// State
let stars = 0;
let isMusicPlaying = false;
let audioCtx = null;
let musicTimer = null;
let currentView = 'menu';

// Custom Background Themes
const THEMES = ['', 'theme-sunshine', 'theme-ocean', 'theme-jungle', 'theme-candy'];
let themeIndex = 0;

// UI Handles
const starCountEl = document.getElementById('star-count');
const musicBtn = document.getElementById('music-btn');
const themeBtn = document.getElementById('theme-btn');
const menuBtn = document.getElementById('menu-btn');

function getAudioContext() {
  if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  if (audioCtx.state === 'suspended') audioCtx.resume();
  return audioCtx;
}

function updateStars(amount = 1) {
  stars += amount;
  starCountEl.textContent = stars;
}

// Theme Picker Toggle
themeBtn.addEventListener('click', () => {
  themeIndex = (themeIndex + 1) % THEMES.length;
  document.body.className = THEMES[themeIndex];
});

// Audio Sound Effects Synthesizer
function playSound(type) {
  const ctx = getAudioContext();
  const osc = ctx.createOscillator();
  const gain = ctx.createGain();
  osc.connect(gain);
  gain.connect(ctx.destination);
  const now = ctx.currentTime;

  if (type === 'success') {
    osc.frequency.setValueAtTime(440, now);
    osc.frequency.exponentialRampToValueAtTime(880, now + 0.3);
    gain.gain.setValueAtTime(0.3, now);
    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
    osc.start(now);
    osc.stop(now + 0.3);
  } else if (type === 'wrong') {
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(180, now);
    osc.frequency.linearRampToValueAtTime(110, now + 0.2);
    gain.gain.setValueAtTime(0.2, now);
    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.2);
    osc.start(now);
    osc.stop(now + 0.2);
  } else if (type === 'pop') {
    osc.frequency.setValueAtTime(400, now);
    osc.frequency.exponentialRampToValueAtTime(80, now + 0.1);
    gain.gain.setValueAtTime(0.3, now);
    gain.gain.linearRampToValueAtTime(0.01, now + 0.1);
    osc.start(now);
    osc.stop(now + 0.1);
  } else if (type === 'nom') {
    osc.frequency.setValueAtTime(200, now);
    osc.frequency.exponentialRampToValueAtTime(600, now + 0.25);
    gain.gain.setValueAtTime(0.3, now);
    gain.gain.linearRampToValueAtTime(0.01, now + 0.25);
    osc.start(now);
    osc.stop(now + 0.25);
  }
}

// Animal Audio Synthesizer (8 Animals)
function playAnimalSound(type) {
  const ctx = getAudioContext();
  const osc = ctx.createOscillator();
  const gain = ctx.createGain();
  osc.connect(gain);
  gain.connect(ctx.destination);
  const now = ctx.currentTime;

  if (type === 'cat') {
    osc.frequency.setValueAtTime(600, now);
    osc.frequency.exponentialRampToValueAtTime(300, now + 0.4);
    gain.gain.setValueAtTime(0.2, now);
    gain.gain.linearRampToValueAtTime(0.01, now + 0.4);
  } else if (type === 'dog') {
    osc.type = 'triangle';
    osc.frequency.setValueAtTime(150, now);
    osc.frequency.setValueAtTime(300, now + 0.05);
    osc.frequency.exponentialRampToValueAtTime(100, now + 0.2);
    gain.gain.setValueAtTime(0.3, now);
    gain.gain.linearRampToValueAtTime(0.01, now + 0.2);
  } else if (type === 'cow') {
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(120, now);
    osc.frequency.linearRampToValueAtTime(100, now + 0.6);
    gain.gain.setValueAtTime(0.25, now);
    gain.gain.linearRampToValueAtTime(0.01, now + 0.6);
  } else if (type === 'duck') {
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(300, now);
    osc.frequency.linearRampToValueAtTime(150, now + 0.25);
    gain.gain.setValueAtTime(0.3, now);
    gain.gain.linearRampToValueAtTime(0.01, now + 0.25);
  } else if (type === 'lion') {
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(80, now);
    osc.frequency.linearRampToValueAtTime(140, now + 0.2);
    osc.frequency.linearRampToValueAtTime(60, now + 0.7);
    gain.gain.setValueAtTime(0.4, now);
    gain.gain.linearRampToValueAtTime(0.01, now + 0.7);
  } else if (type === 'pig') {
    osc.type = 'square';
    osc.frequency.setValueAtTime(220, now);
    osc.frequency.linearRampToValueAtTime(180, now + 0.15);
    gain.gain.setValueAtTime(0.2, now);
    gain.gain.linearRampToValueAtTime(0.01, now + 0.15);
  } else if (type === 'monkey') {
    osc.type = 'sine';
    osc.frequency.setValueAtTime(700, now);
    osc.frequency.exponentialRampToValueAtTime(1200, now + 0.15);
    gain.gain.setValueAtTime(0.25, now);
    gain.gain.linearRampToValueAtTime(0.01, now + 0.15);
  } else if (type === 'elephant') {
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(350, now);
    osc.frequency.exponentialRampToValueAtTime(650, now + 0.4);
    osc.frequency.linearRampToValueAtTime(250, now + 0.8);
    gain.gain.setValueAtTime(0.3, now);
    gain.gain.linearRampToValueAtTime(0.01, now + 0.8);
  }
  
  osc.start(now);
  osc.stop(now + 0.8);
}

// Background Music Synthesizer
function playMelodyNote(note, duration) {
  if (!isMusicPlaying) return;
  const ctx = getAudioContext();
  const osc = ctx.createOscillator();
  const gain = ctx.createGain();
  osc.type = 'sine';
  osc.frequency.setValueAtTime(note, ctx.currentTime);
  gain.gain.setValueAtTime(0.04, ctx.currentTime);
  gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
  osc.connect(gain);
  gain.connect(ctx.destination);
  osc.start();
  osc.stop(ctx.currentTime + duration);
}

musicBtn.addEventListener('click', () => {
  getAudioContext();
  isMusicPlaying = !isMusicPlaying;
  if (isMusicPlaying) {
    musicBtn.textContent = '🎵 Music: ON';
    const notes = [261.63, 293.66, 329.63, 392.00, 440.00, 392.00];
    let index = 0;
    musicTimer = setInterval(() => {
      if (isMusicPlaying) {
        playMelodyNote(notes[index], 0.35);
        index = (index + 1) % notes.length;
      }
    }, 450);
  } else {
    musicBtn.textContent = '🎵 Music: OFF';
    clearInterval(musicTimer);
  }
});

// View Navigation
function switchView(viewName) {
  document.querySelectorAll('.view').forEach(v => v.classList.add('hidden'));
  document.getElementById(`view-${viewName}`).classList.remove('hidden');
  currentView = viewName;

  if (viewName === 'menu') {
    menuBtn.classList.add('hidden');
    clearBalloonGame();
  } else {
    menuBtn.classList.remove('hidden');
    if (viewName === 'shapes') initShapesGame();
    if (viewName === 'balloons') initBalloonGame();
    if (viewName === 'monster') initMonsterGame();
  }
}

document.querySelectorAll('.menu-card').forEach(card => {
  card.addEventListener('click', () => switchView(card.dataset.game));
});

menuBtn.addEventListener('click', () => switchView('menu'));

// --- GAME 1: SHAPE MATCH ---
const SHAPES = [
  { name: 'circle', color: '#ff5964' },
  { name: 'square', color: '#35a7ff' },
  { name: 'star', color: '#ffe066' },
  { name: 'triangle', color: '#38b000' },
  { name: 'heart', color: '#ff4d6d' },
  { name: 'moon', color: '#7209b7' }
];
let shapeDifficulty = 'easy';
let shapeTarget = null;
let activeDragEl = null;
let dragOffset = { x: 0, y: 0 };

document.querySelectorAll('.diff-btn').forEach(btn => {
  btn.addEventListener('click', (e) => {
    document.querySelectorAll('.diff-btn').forEach(b => b.classList.remove('active'));
    e.target.classList.add('active');
    shapeDifficulty = e.target.dataset.mode;
    initShapesGame();
  });
});

function initShapesGame() {
  const container = document.getElementById('shape-choices');
  const targetSlot = document.getElementById('shape-target');
  const msg = document.getElementById('shape-msg');
  const nextBtn = document.getElementById('shape-next');

  container.innerHTML = '';
  msg.textContent = "Match the shape!";
  nextBtn.classList.add('hidden');
  targetSlot.className = 'shape-slot';
  targetSlot.style.backgroundColor = '#f8f8f8';
  targetSlot.innerHTML = '<span class="slot-label">Drag or Tap Here!</span>';

  shapeTarget = SHAPES[Math.floor(Math.random() * SHAPES.length)];
  targetSlot.style.borderColor = shapeTarget.color;

  const choiceCount = shapeDifficulty === 'easy' ? 2 : shapeDifficulty === 'medium' ? 3 : 4;
  const options = [shapeTarget];
  const remaining = SHAPES.filter(s => s.name !== shapeTarget.name);

  while (options.length < choiceCount && remaining.length > 0) {
    options.push(remaining.splice(Math.floor(Math.random() * remaining.length), 1)[0]);
  }

  options.sort(() => Math.random() - 0.5).forEach(item => {
    const el = document.createElement('div');
    el.classList.add('shape', item.name);
    if (item.name === 'triangle') el.style.borderBottomColor = item.color;
    else el.style.backgroundColor = item.color;

    addPointerListeners(el, item);
    container.appendChild(el);
  });
}

function addPointerListeners(element, itemData) {
  element.addEventListener('pointerdown', (e) => {
    activeDragEl = element;
    const rect = element.getBoundingClientRect();
    dragOffset = { x: e.clientX - rect.left, y: e.clientY - rect.top };
    element.classList.add('dragging');
    element.style.position = 'fixed';
    element.style.left = `${e.clientX - dragOffset.x}px`;
    element.style.top = `${e.clientY - dragOffset.y}px`;
    element.setPointerCapture(e.pointerId);
  });

  element.addEventListener('pointermove', (e) => {
    if (!activeDragEl) return;
    element.style.left = `${e.clientX - dragOffset.x}px`;
    element.style.top = `${e.clientY - dragOffset.y}px`;
  });

  element.addEventListener('pointerup', (e) => {
    if (!activeDragEl) return;
    const targetSlot = document.getElementById('shape-target');
    const slotRect = targetSlot.getBoundingClientRect();
    const isOver = (
      e.clientX >= slotRect.left && e.clientX <= slotRect.right &&
      e.clientY >= slotRect.top && e.clientY <= slotRect.bottom
    );

    activeDragEl = null;
    element.classList.remove('dragging');
    element.style.position = 'static';

    if (isOver) {
      if (itemData.name === shapeTarget.name) {
        playSound('success');
        updateStars(1);
        document.getElementById('shape-msg').textContent = "Yay! Perfect Match! 🎉";
        targetSlot.innerHTML = '';
        const filled = document.createElement('div');
        filled.classList.add('shape', itemData.name, 'celebrate');
        if (itemData.name === 'triangle') filled.style.borderBottomColor = itemData.color;
        else filled.style.backgroundColor = itemData.color;
        targetSlot.appendChild(filled);
        document.getElementById('shape-choices').innerHTML = '';
        document.getElementById('shape-next').classList.remove('hidden');
      } else {
        playSound('wrong');
        document.getElementById('shape-msg').textContent = "Oops! Try another shape! 💡";
      }
    }
  });
}

document.getElementById('shape-next').addEventListener('click', initShapesGame);

// --- GAME 2: ANIMAL SAFARI ---
document.querySelectorAll('.animal-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const name = btn.dataset.animal;
