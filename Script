// --- GAME 3: POP THE BALLOON ---
let balloonTargetNum = 1;
let balloonIntervals = [];

function clearBalloonGame() {
  balloonIntervals.forEach(clearInterval);
  balloonIntervals = [];
  document.getElementById('balloon-sky').innerHTML = '';
}

function initBalloonGame() {
  clearBalloonGame();
  balloonTargetNum = 1;
  document.getElementById('balloon-target-text').textContent = `Pop in order: 1`;
  spawnBalloonWave();
}

function spawnBalloonWave() {
  const colors = ['#ff4d6d', '#3a86ff', '#38b000', '#ffbe0b', '#8338ec'];
  for (let i = 1; i <= 4; i++) {
    setTimeout(() => {
      if (currentView !== 'balloons') return;
      const b = document.createElement('div');
      b.className = 'balloon';
      b.textContent = i;
      b.style.backgroundColor = colors[i - 1];
      b.style.left = `${Math.random() * 70 + 10}%`;

      document.getElementById('balloon-sky').appendChild(b);

      let pos = -80;
      const timer = setInterval(() => {
        pos += 1.2;
        b.style.bottom = `${pos}px`;
        if (pos > 290) {
          clearInterval(timer);
          b.remove();
        }
      }, 20);

      balloonIntervals.push(timer);

      b.addEventListener('pointerdown', () => {
        if (i === balloonTargetNum) {
          playSound('pop');
          clearInterval(timer);
          b.remove();
          updateStars(1);
          balloonTargetNum++;
          if (balloonTargetNum > 4) {
            document.getElementById('balloon-target-text').textContent = "Great job! 🎉";
            setTimeout(initBalloonGame, 1000);
          } else {
            document.getElementById('balloon-target-text').textContent = `Pop in order: ${balloonTargetNum}`;
          }
        } else {
          playSound('wrong');
        }
      });
    }, (i - 1) * 800);
  }
}

// --- GAME 4: HUNGRY MONSTER ---
const FOODS = [
  { name: 'RED apple', emoji: '🍎', color: 'RED' },
  { name: 'YELLOW banana', emoji: '🍌', color: 'YELLOW' },
  { name: 'GREEN kiwi', emoji: '🥝', color: 'GREEN' },
  { name: 'ORANGE orange', emoji: '🍊', color: 'ORANGE' }
];
let targetFood = null;

function initMonsterGame() {
  const tray = document.getElementById('food-tray');
  const speech = document.getElementById('monster-speech');
  const avatar = document.getElementById('monster-avatar');

  tray.innerHTML = '';
  targetFood = FOODS[Math.floor(Math.random() * FOODS.length)];
  speech.textContent = `Feed me a ${targetFood.name}!`;

  [...FOODS].sort(() => Math.random() - 0.5).forEach(item => {
    const btn = document.createElement('div');
    btn.className = 'food-item';
    btn.textContent = item.emoji;

    btn.addEventListener('click', () => {
      if (item.color === targetFood.color) {
        playSound('nom');
        updateStars(1);
        avatar.classList.add('celebrate');
        speech.textContent = 'YUM! Thank you! 😋';
        tray.innerHTML = '';
        setTimeout(() => {
          avatar.classList.remove('celebrate');
          initMonsterGame();
        }, 1200);
      } else {
        playSound('wrong');
        speech.textContent = `Oops! I want a ${targetFood.name}! 💡`;
      }
    });

    tray.appendChild(btn);
  });
}
